includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
    level: 0
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        - '#attribute\\.notFound#'
        - '#staticMethod\\.notFound#'
        - '#return\\.missing#'
        - '#class\\.notFound#'
        - '#assign\\.propertyType#'
